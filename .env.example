# Postgres credentials and host port used by docker-compose.yml.
# Defaults match the compose fallbacks, so you can leave these as-is for local dev.
POSTGRES_USER=recklessbricks
POSTGRES_PASSWORD=recklessbricks_dev
POSTGRES_DB=recklessbricks
# Host port for the Postgres container. Change this if 5433 is already in use —
# and update the port in DATABASE_URL below to match.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Connection string used by Prisma and Next.js. Host/port/user/password/db must
# match the POSTGRES_* values above (host is localhost since the container's
# 5432 is published to POSTGRES_PORT on the host).
DATABASE_URL=postgresql://recklessbricks:recklessbricks_dev@localhost:5433/recklessbricks

# SMTP (nodemailer) — transactional email for verification codes and submission
# updates. If SMTP_HOST is left blank, emails are logged to the server console
# instead of being sent (useful for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RecklessBricks <no-reply@recklessbricks.com>"

# Public site URL used in outgoing email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Leave blank to
# disable analytics (e.g. local dev); when blank, no gtag script is loaded.
NEXT_PUBLIC_GA_ID=

# YouTube Data API v3 key — used to refresh real video dates/durations/views.
# Create one (free) in Google Cloud Console → APIs & Services → Credentials,
# with the "YouTube Data API v3" enabled. Leave blank to disable refreshing.
# When set, an in-process node-cron job (src/instrumentation.ts) refreshes
# stats on a schedule; when blank, the scheduler is disabled.
YOUTUBE_API_KEY=

# Optional cron expression for the refresh schedule (default "0 3 * * *" = 03:00
# daily). Optionally set YOUTUBE_REFRESH_TZ (e.g. America/Denver) for the zone.
YOUTUBE_REFRESH_CRON=

# Optional shared secret for the manual POST /api/videos/refresh and
# /api/collection/refresh endpoints ("Authorization: Bearer <CRON_SECRET>").
# The scheduled jobs do NOT need this — they call the refresh directly
# in-process. Generate: openssl rand -hex 32
CRON_SECRET=

# ── LEGO collection (src/lib/brickeconomy.ts, lego-prices.ts) ───────────────
# BrickEconomy API key (request access at brickeconomy.com); sent as a bearer
# token. Two consumers:
#   • `pnpm db:seed:lego` imports your full collection from the
#     /collection/sets and /collection/minifigs endpoints (run once after
#     building the collection on brickeconomy.com).
#   • When set, an in-process node-cron job also refreshes each set's current
#     market value weekly; blank disables the refresh and the import.
BRICKECONOMY_API_KEY=

# Set to 1 to log one raw API item per endpoint on import, so you can confirm
# the JSON field names match the normalizers in src/lib/brickeconomy.ts.
BRICKECONOMY_DEBUG=

# Optional cron expression for the value refresh (default "0 4 * * 1" = 04:00
# Mondays). Optionally set BRICKECONOMY_REFRESH_TZ (e.g. America/Denver).
BRICKECONOMY_REFRESH_CRON=

# ── Realtime ingestion (src/lib/ingest.ts) ──────────────────────────────────
# Runs on the same node-cron schedule. Each source is OFF until both its
# credentials and at least one query/target below are set. Ingested rows use
# "ext-" IDs and survive reseeds.

# YouTube video search — reuses YOUTUBE_API_KEY above. Comma-separated terms.
INGEST_YOUTUBE_QUERIES=

# Reddit (free, official): create a "web app" at reddit.com/prefs/apps to get
# these. Provide queries and/or subreddits (comma-separated; "r/" optional).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
INGEST_REDDIT_QUERIES=
INGEST_REDDIT_SUBREDDITS=

# X / Twitter (official API v2, but read access requires a PAID plan). Provide
# a bearer token and comma-separated search queries to enable.
X_BEARER_TOKEN=
INGEST_X_QUERIES=

# Note: TikTok, Instagram, and Facebook have no official public-post search,
# so they cannot be ingested here without scrapers (out of scope).

# Legal-document / bodycam scraping (src/lib/scrape.ts) of bamsucks.com and
# recklessben.tufo.dev runs on the same schedule. Set to "false" to disable.
SCRAPE_ENABLED=true
