# systemd unit for the recklessbricks.com Next.js app.
#
# Install on the server (as a user with sudo):
#   sudo cp deploy/recklessbricks.service /etc/systemd/system/recklessbricks.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now recklessbricks
#
# Requires Node.js and pnpm available system-wide for the service user, e.g.:
#   sudo corepack enable            # provides `pnpm` on PATH
# Adjust ExecStart's pnpm path to match `command -v pnpm` on the server.

[Unit]
Description=recklessbricks.com (Next.js)
# Postgres runs in Docker via docker-compose, so wait for Docker to be up.
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=recklesslegos
Group=recklesslegos

# The GitHub Actions runner checks the repo out here and builds in place.
WorkingDirectory=/home/recklesslegos/actions-runner/_work/recklessbricks.com/recklessbricks.com

# Load DATABASE_URL and POSTGRES_* (written by the "Write .env" deploy step).
EnvironmentFile=/home/recklesslegos/actions-runner/_work/recklessbricks.com/recklessbricks.com/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
# systemd uses a minimal PATH that excludes the nvm node dir, so pnpm's
# `#!/usr/bin/env node` lookup fails ("env: 'node': No such file or directory")
# and the service crash-loops. Put the nvm node bin dir on PATH to fix it.
# If you upgrade node via nvm, update this version-pinned path to match.
Environment=PATH=/home/recklesslegos/.nvm/versions/node/v24.16.0/bin:/usr/local/bin:/usr/bin:/bin

# `pnpm start` runs `next start`. Use an absolute path so systemd (which has a
# minimal PATH) can find pnpm; confirm it with `command -v pnpm` on the server.
ExecStart=/home/recklesslegos/.nvm/versions/node/v24.16.0/bin/pnpm start

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
