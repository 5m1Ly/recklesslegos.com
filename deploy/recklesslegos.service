# systemd unit for the recklesslegos.com Next.js app.
#
# Install on the server (as a user with sudo):
#   sudo cp deploy/recklesslegos.service /etc/systemd/system/recklesslegos.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now recklesslegos
#
# Requires Node.js and pnpm available system-wide for the service user, e.g.:
#   sudo corepack enable            # provides `pnpm` on PATH
# Adjust ExecStart's pnpm path to match `command -v pnpm` on the server.

[Unit]
Description=recklesslegos.com (Next.js)
# Postgres runs in Docker via docker-compose, so wait for Docker to be up.
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=recklesslegos
Group=recklesslegos

# The GitHub Actions runner checks the repo out here and builds in place.
WorkingDirectory=/home/recklesslegos/actions-runner/_work/recklesslegos.com/recklesslegos.com

# Load DATABASE_URL and POSTGRES_* (written by the "Write .env" deploy step).
EnvironmentFile=/home/recklesslegos/actions-runner/_work/recklesslegos.com/recklesslegos.com/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0

# `pnpm start` runs `next start`. Use an absolute path so systemd (which has a
# minimal PATH) can find pnpm; confirm it with `command -v pnpm` on the server.
ExecStart=/usr/bin/pnpm start

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
