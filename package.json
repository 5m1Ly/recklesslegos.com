{
  "name": "recklessbricks.com",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "type-check": "tsc --noEmit",
    "test": "echo 'No tests configured' && exit 0",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:wait": "for i in $(seq 1 60); do [ \"$(docker inspect --format='{{.State.Health.Status}}' recklessbricks_db 2>/dev/null)\" = healthy ] && exit 0; sleep 1; done; echo 'Postgres did not become healthy in 60s; recent container logs:' >&2; docker logs --tail 30 recklessbricks_db; exit 1",
    "db:push": "prisma migrate dev && prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:admin": "tsx prisma/seed-admin.ts",
    "db:studio": "prisma studio",
    "setup": "pnpm db:up && pnpm db:wait && pnpm db:push && pnpm db:seed",
    "media:download": "tsx scripts/download-dropbox.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@next/third-parties": "16.2.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/unzipper": "^0.10.11",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "unzipper": "^0.12.3"
  }
}
