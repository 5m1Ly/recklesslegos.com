generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Person {
  id       String  @id
  name     String
  role     String
  org      String
  side     String
  verified Boolean @default(false)
  orgFlag  Boolean @default(false)
  bio      String

  events EventPerson[]
}

model Event {
  id         String   @id
  date       String
  title      String
  cats       String[]
  desc       String
  ongoing    Boolean  @default(false)
  relVideos  Int      @default(0)
  relDocs    Int      @default(0)
  relBodycam Int      @default(0)
  relSocial  Int      @default(0)

  people    EventPerson[]
  videos    Video[]
  bodycam   Bodycam[]
  documents Document[]
  social    SocialPost[]
}

model EventPerson {
  eventId  String
  personId String

  event  Event  @relation(fields: [eventId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@id([eventId, personId])
}

model Video {
  id       String  @id
  tier     String
  title    String
  source   String
  platform String
  date     String
  dur      String
  views    String  @default("—")
  official Boolean @default(false)
  url      String?

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])
}

model Bodycam {
  id       String  @id
  title    String
  officer  String
  unit     String
  date     String
  time     String
  dur      String
  location String
  type     String
  released String
  url      String?

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])
}

model Document {
  id      String   @id
  title   String
  type    String
  source  String
  date    String
  pages   Int
  tags    String[]
  summary String
  url     String?

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])
}

model SocialPost {
  id       String  @id
  platform String
  author   String
  handle   String
  date     String
  text     String
  likes    String
  reposts  String
  replies  String
  verified Boolean @default(false)
  url      String?

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])
}

// --- Community-editable timeline ---

model TimelineEntry {
  id          String        @id @default(cuid())
  date        String // ISO "YYYY-MM-DD"
  title       String
  description String
  ongoing     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  refs        TimelineRef[]
}

// Polymorphic reference to an existing content item.
model TimelineRef {
  id      String        @id @default(cuid())
  entryId String
  entry   TimelineEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  refType String // "video" | "bodycam" | "document" | "social" | "person"
  refId   String

  @@index([entryId])
}

// A proposed change to a content item, awaiting verification + admin approval.
// `contentType` discriminates: "timeline" uses the dedicated columns below;
// the five content types (video/bodycam/document/social/person) store their
// fields in `payload`. See src/lib/proposals.ts.
model Submission {
  id            String    @id @default(cuid())
  contentType   String    @default("timeline") // timeline | video | bodycam | document | social | person
  op            String // "add" | "edit" | "remove"
  targetId      String? // TimelineEntry id (timeline) or content row id (other types) for edit/remove
  // Timeline-specific columns (unused by the other content types):
  date          String?
  title         String?
  description   String?
  ongoing       Boolean   @default(false)
  refs          Json? // [{ refType, refId }]
  // Type-specific field bag for the five non-timeline content types:
  payload       Json?
  email         String
  emailHash     String? // sha256(normalized email); survives email purge for counts/consent lookup
  wantsUpdates  Boolean   @default(false)
  emailVerified Boolean   @default(false)
  codeHash      String?
  codeExpires   DateTime?
  codeAttempts  Int       @default(0)
  status        String    @default("draft") // draft | pending | accepted | rejected
  adminNote     String?
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?
}

// One row per contributor email (keyed by hash so we never retain the plaintext
// email of someone who declined storage). Records the two consent answers so we
// only ask once per email. See src/lib/contributors.ts.
model Contributor {
  id                  String   @id @default(cuid())
  emailHash           String   @unique // sha256(normalized email)
  displayName         String?
  redactedEmail       String? // stored only when consentListPublicly = true
  consentStoreEmail   Boolean  @default(false)
  consentListPublicly Boolean  @default(false)
  askedAt             DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model AdminLoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Persistent login for contributors: created the first time a contributor
// verifies their email code, so subsequent add/edit/remove proposals don't
// require re-verifying by email.
model ContributorSession {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  emailHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
