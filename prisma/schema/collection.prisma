model Collection {
    id String @id

    title       String
    description String

    totalSets      Int @default(0)
    totalSetsValue Int @default(0)

    totalFigs      Int @default(0)
    totalFigsValue Int @default(0)

    items CollectionItem[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum CIType {
    SET
    MINIFIGURE
}

