model CollectionItem {
    /**
     * @alias LegoSet.id
     * @alias LegoMinifig.id
     * @description previously known as LegoSet.id and LegoMinifig.id
     */
    id String @id

    /**
     * @alias LegoSet.setNumber
     * @alias LegoMinifig.minifigNumber
     * @description previously known as LegoSet.setNumber and LegoMinifig.minifigNumber
     */
    legoRef String @default("")

    type CIType @default(SET)

    /**
     * @alias LegoSet.theme
     * @alias LegoMinifig.theme
     * @description previously known as LegoSet.theme and LegoMinifig.theme
     */
    theme CIThemes @default(STARWARS)

    /**
     * @alias LegoSet.theme
     * @alias LegoMinifig.theme
     * @description previously known as LegoSet.theme and LegoMinifig.theme
     */
    subtheme CISubthemes @default(STARWARS)

    /**
     * @alias LegoSet.year
     * @alias LegoMinifig.year
     * @description previously known as LegoSet.year and LegoMinifig.year
     */
    year Int @default(0)

    /**
     * @alias LegoSet.name
     * @alias LegoMinifig.name
     * @description previously known as LegoSet.name and LegoMinifig.name
     */
    name String

    /**
     * @alias LegoSet.imageUrl
     * @alias LegoMinifig.imageUrl
     * @description previously known as LegoSet.imageUrl and LegoMinifig.imageUrl
     */
    imageUrl String?

    /**
     * @alias LegoSet.notes
     * @alias LegoMinifig.notes
     * @description free-form curated notes carried over from the legacy models.
     */
    notes String @default("")

    /**
     * @description copy count is the number of CollectionItemEntry rows — one per
     * owned copy — so there is no denormalized quantity field here.
     */

    /**
     * @alias LegoSet.pieces
     * @description previously known as LegoSet.pieces
     * @description the default of 2 refers is set for the minifigures which have fixed legs and torse (smaller once like yoda) and a head.
     */
    pieces Int @default(2)

    /**
     * @description when false the collection-level BrickEconomy refresh skips this
     * item, so a manual (admin) evaluation is never overwritten automatically.
     */
    autoEvaluate Boolean @default(true)

    collectionId String
    collection   Collection @relation(fields: [collectionId], references: [id])

    /**
     * @description this allows us to register minifigures which are inside a lego set. But since we also register minifigures in this table we made the setId optional to prefent the code from failing
     */
    setId    String?
    set      CollectionItem?  @relation("Set", fields: [setId], references: [id])
    minifigs CollectionItem[] @relation("Set")

    evaluations CollectionItemEvaluation[]
    entries     CollectionItemEntry[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum CIESource {
    BRICKECONOMY
    BRICKSET
    EBAY
    // generic in-person appraisal / other site, admin-entered
    MANUAL
    // price suggestions submitted by a contributor or admin
    CONTRIBUTORS
}

enum CIECurrencies {
    EUR
    USD
}

/**
 * One price reading for an item from a single source. `value`/`valueLow`/
 * `valueHigh` are the headline figures every source fills (they drive the card
 * average and the per-source page totals); the boxed/used breakdown is optional
 * richer detail for sources that split new vs. used (e.g. BrickEconomy).
 */
model CollectionItemEvaluation {
    id String @id @default(cuid())

    itemId String
    item   CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

    source   CIESource     @default(BRICKECONOMY)
    currency CIECurrencies @default(USD)

    retail Int @default(0)

    // headline market value used for averages + totals
    value     Int @default(0)
    valueLow  Int @default(0)
    valueHigh Int @default(0)

    // optional new/used breakdown (BrickEconomy single-set endpoint)
    boxed     Int @default(0)
    boxedLow  Int @default(0)
    boxedHigh Int @default(0)

    used     Int @default(0)
    usedLow  Int @default(0)
    usedHigh Int @default(0)

    // contributor attribution / appraisal note
    note String @default("")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([itemId, source])
}

enum CIECondition {
    BOXED
    USED
}

enum CIELocation {
    HOME
    STORE
    STORAGE
    // all the empty cells or the once that list the word "Crack" should be definded as unknown
    UNKNOWN
}

/**
 * What is happening with a copy. Orthogonal to physical location: an item can be
 * SOLD or STOLEN while we still record where it physically was/is.
 */
enum CIDisposition {
    FOR_SALE
    SOLD
    LAYAWAY
    STOLEN
    RECOVERED
}

model CollectionItemEntry {
    id String @id @default(cuid())

    itemId String
    item   CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

    condition CIECondition @default(USED)

    /**
     * @alias LegoSet.status
     * @alias LegoMinifig.status
     * @description previously known as LegoSet.status and LegoMinifig.status — the
     * PHYSICAL location only; sale state lives in `disposition`.
     */
    location CIELocation @default(STORE)

    disposition CIDisposition @default(FOR_SALE)

    isCrack       Boolean @default(false)
    isBuild       Boolean @default(false)
    isBuildWOFigs Boolean @default(false)

    costPrice    Int @default(0) // the payed price
    displayPrice Int @default(0) // the asking price in the store
    /**
     * @alias LegoSet.soldPrice
     * @alias LegoMinifig.soldPrice
     * @description previously known as LegoSet.soldPrice and LegoMinifig.soldPrice
     */
    sellPrice Int @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([itemId])
}
